# ==============================================================================
# GoDaddy SMTP Configuration
# ==============================================================================
# Copy this file to '.env' and fill in your real credentials:
#   copy .env.example .env
# Never commit the '.env' file with real passwords to version control!
# ==============================================================================

# GoDaddy SMTP Host:
# - Standard GoDaddy cPanel / Workspace Webmail: smtpout.secureserver.net
# - GoDaddy Microsoft 365 Email: smtp.office365.com (requires TLS on port 587 or SSL on 465)
SMTP_HOST=smtpout.secureserver.net

# SMTP Port (GoDaddy SSL standard: 465)
SMTP_PORT=465

# SMTP Encryption: ssl
SMTP_SECURE=ssl

# SMTP Authentication: true
SMTP_AUTH=true

# SMTP Credentials (wrap in quotes if your password contains special characters like #, $, !, etc.)
SMTP_USERNAME="your-godaddy-email@yourdomain.com"
SMTP_PASSWORD="your-email-password-here"

# Sender Details (Note: GoDaddy requires From address to match or be authorized by SMTP_USERNAME)
MAIL_FROM_ADDRESS=your-godaddy-email@yourdomain.com
MAIL_FROM_NAME="Royal Enan Security Services"

# Admin Recipient Details (Where enquiry emails should be delivered)
MAIL_TO_ADDRESS=admin@yourdomain.com
MAIL_TO_NAME="Royal Enan Admin"

# Debug Level (0 = off for production, 1 = client commands, 2 = client + server responses)
MAIL_DEBUG=0

